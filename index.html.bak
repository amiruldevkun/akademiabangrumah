<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome - Akademi Abang Rumah</title>
  <link rel="stylesheet" href="output.css">
</head>
<body class="min-h-screen bg-gray-50 flex flex-col justify-between font-sans">
  <!-- Simple Header -->
  <header class="bg-[#4a7425] text-white p-1 flex items-center shadow-md z-50">
    <span class="text-lg font-bold tracking-wide mx-4">AKADEMI ABANG RUMAH</span>
    <a href="../about.html" class="ms-auto">
      <img src="../assets/images/akademilogov2.png" alt="Akademi Abang Rumah Logo" class="p-2 w-22 h-auto">
    </a>
  </header>

  <!-- Hero Welcome Content -->
  <main class="flex-1 flex flex-col items-center justify-center p-6 text-center max-w-2xl mx-auto">
    <img src="assets/images/welcome_image.jpg" alt="Welcome Image" class="w-full max-w-md mb-6 rounded-lg shadow-lg">
    <h1 class="text-4xl lg:text-5xl font-extrabold text-gray-900 mb-4 tracking-tight">
      Selamat Datang ke Akademi Abang Rumah
    </h1>
    <p class="text-lg text-gray-600 mb-8 leading-relaxed">
      Tingkatkan kemahiran anda dengan akses video pembelajaran eksklusif secara fleksibel pada bila-bila masa.
    </p>

    <!-- Call to Action Button to redirect to classroom -->
    <a href="/premium_access/classroom.html" class="inline-block bg-[#4a7425] text-white font-semibold text-lg px-8 py-4 rounded-xl shadow-lg hover:bg-[#4a7425] transition-all transform hover:-translate-y-1 active:translate-y-0 w-full sm:w-auto">
      Mula Belajar Sekarang &rarr;
    </a>
  </main>

  <!-- Simple Footer -->
  <footer class="bg-gray-100 text-gray-500 text-sm p-4 text-center border-t">
    &copy; 2026 Akademi Abang Rumah. Hak Cipta Terpelihara.
  </footer>

</body>
</html>